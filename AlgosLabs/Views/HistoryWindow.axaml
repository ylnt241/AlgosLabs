<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:AlgosLabs.Services"
        x:Class="AlgosLabs.Views.HistoryWindow"
        Title="История замеров из БД (SQLite)"
        Width="650" Height="420"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*, Auto" Margin="12">
        <DataGrid x:Name="HistoryGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  Grid.Row="0">
            <DataGrid.Columns>
                <!-- Сравнить (CheckBox) -->
                <DataGridTemplateColumn Header="Сравнить">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="services:BenchmarkHistoryGroup">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Время запуска -->
                <DataGridTemplateColumn Header="Время запуска">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="services:BenchmarkHistoryGroup">
                            <TextBlock Text="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm:ss\}}"
                                       VerticalAlignment="Center"
                                       Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Алгоритм -->
                <DataGridTemplateColumn Header="Алгоритм">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="services:BenchmarkHistoryGroup">
                            <TextBlock Text="{Binding AlgorithmId}"
                                       VerticalAlignment="Center"
                                       Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Max N -->
                <DataGridTemplateColumn Header="Max N">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="services:BenchmarkHistoryGroup">
                            <TextBlock Text="{Binding MaxN}"
                                       VerticalAlignment="Center"
                                       Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Точек -->
                <DataGridTemplateColumn Header="Точек">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="services:BenchmarkHistoryGroup">
                            <TextBlock Text="{Binding PointsCount}"
                                       VerticalAlignment="Center"
                                       Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Сравнить на графике" Click="OnCompareClick" Classes="accent" />
            <Button Content="Закрыть" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>