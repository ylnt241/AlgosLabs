<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AlgosLabs.ViewModels"
        x:Class="AlgosLabs.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Лабораторный комплекс алгоритмов"
        Width="850" Height="650"
        MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- Цвета выбранной кнопки навигации (совпадают со стандартным акцентом Fluent) -->
        <SolidColorBrush x:Key="NavPillAccentBrush">#0078D4</SolidColorBrush>
        <SolidColorBrush x:Key="NavPillAccentHoverBrush">#005A9E</SolidColorBrush>

        <!-- Общий стиль кнопок навигации: верхняя строка (лабы) и нижняя строка (разделы) -->
        <ControlTheme x:Key="NavPillTheme" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Толщина задана заранее, чтобы обводка фокуса не сдвигала соседние кнопки -->
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PillRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <!-- Наведение на невыбранную кнопку -->
            <Style Selector="^:pointerover /template/ Border#PillRoot">
                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
            </Style>

            <!-- Выбранная кнопка -->
            <Style Selector="^:checked /template/ Border#PillRoot">
                <Setter Property="Background" Value="{StaticResource NavPillAccentBrush}" />
            </Style>

            <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="White" />
            </Style>

            <Style Selector="^:checked:pointerover /template/ Border#PillRoot">
                <Setter Property="Background" Value="{StaticResource NavPillAccentHoverBrush}" />
            </Style>

            <!-- Обводка для навигации с клавиатуры -->
            <Style Selector="^:focus-visible /template/ Border#PillRoot">
                <Setter Property="BorderBrush" Value="{StaticResource NavPillAccentBrush}" />
            </Style>
        </ControlTheme>
    </Window.Resources>

    <!-- Шапка, лабы, контент, разделы и индикатор; растягивается только контент. -->
    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto" Margin="16">

        <!-- Шапка: заголовок и кнопки работы с историей. -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemRegionBrush}"
                CornerRadius="8"
                Padding="8,6"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Command="{Binding OpenHistoryCommand}"
                        Content="История запусков"
                        Margin="4,0" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding ClearHistoryAndCacheCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Content="Очистить историю и кэш"
                        Margin="4,0" />
                <TextBlock Text="Лабораторный комплекс алгоритмов"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="15"
                           Margin="8,0,0,0" />
            </DockPanel>
        </Border>

        <!-- Выбор лабораторной работы. -->
        <Border Grid.Row="1"
                Background="{DynamicResource SystemRegionBrush}"
                CornerRadius="8"
                Padding="8">
            <ItemsControl ItemsSource="{Binding Labs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LabViewModel">
                        <RadioButton Theme="{StaticResource NavPillTheme}"
                                     GroupName="Labs"
                                     Margin="0,0,6,0"
                                     Content="{Binding Title}"
                                     IsChecked="{Binding IsSelected}"
                                     Command="{Binding $parent[Window].DataContext.SelectLabCommand}"
                                     CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Содержимое выбранного раздела. -->
        <Grid Grid.Row="2">
            <!-- Пока лаба не выбрана, показываем подсказку. -->
            <Border IsVisible="{Binding !HasSelectedLab}"
                    Background="{DynamicResource SystemRegionBrush}"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MaxWidth="440"
                            Spacing="6">
                    <TextBlock Text="Выберите лабораторную работу"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Нажмите «1 Лаба» или «2 Лаба» — разделы выбранной лабы появятся внизу окна."
                               FontSize="13"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                </StackPanel>
            </Border>

            <ContentControl IsVisible="{Binding HasSelectedSection}"
                            Content="{Binding CurrentSectionView}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>

        <!-- Разделы выбранной лабы. -->
        <Border Grid.Row="3"
                Background="{DynamicResource SystemRegionBrush}"
                CornerRadius="8"
                Padding="8"
                Margin="0,10,0,0"
                IsVisible="{Binding HasSelectedLab}">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                <TextBlock Grid.Column="0"
                           Text="Разделы"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />

                <ItemsControl Grid.Column="1" ItemsSource="{Binding SelectedLab.Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LabSectionViewModel">
                            <RadioButton Theme="{StaticResource NavPillTheme}"
                                         GroupName="LabSections"
                                         Margin="0,0,6,0"
                                         Content="{Binding Title}"
                                         IsChecked="{Binding IsSelected}"
                                         Command="{Binding $parent[Window].DataContext.SelectSectionCommand}"
                                         CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Индикатор фоновых операций. -->
        <ProgressBar Grid.Row="4"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Height="3"
                     Margin="0,10,0,0"
                     HorizontalAlignment="Stretch" />
    </Grid>
</Window>
